<?xml version="1.0" encoding="utf-8"?>
<!-- Project Europa: pantheon icons. The .dds atlases are generated by
     tools/make_pantheon_icons.py (4 columns x 2 rows, cell order = Index below), in the same
     four sizes as the stock pantheon atlas.

     The atlas name contains "BELIEFS_PATHEON" on purpose (that is Firaxis's own spelling of
     the stock atlas, ICON_ATLAS_BELIEFS_PATHEON). The "Spare Beliefs" mod copies every icon
     whose atlas name matches that text when it duplicates the beliefs; without a copied icon
     the pantheon chooser cannot draw the duplicate. -->
<GameInfo>
	<IconTextureAtlases>
		<Row Name="ICON_ATLAS_EUROPA_BELIEFS_PATHEON" IconSize="32" IconsPerRow="4" IconsPerColumn="2" Filename="Europa_Pantheons32.dds"/>
		<Row Name="ICON_ATLAS_EUROPA_BELIEFS_PATHEON" IconSize="50" IconsPerRow="4" IconsPerColumn="2" Filename="Europa_Pantheons50.dds"/>
		<Row Name="ICON_ATLAS_EUROPA_BELIEFS_PATHEON" IconSize="64" IconsPerRow="4" IconsPerColumn="2" Filename="Europa_Pantheons64.dds"/>
		<Row Name="ICON_ATLAS_EUROPA_BELIEFS_PATHEON" IconSize="256" IconsPerRow="4" IconsPerColumn="2" Filename="Europa_Pantheons256.dds"/>
	</IconTextureAtlases>
	<IconDefinitions>
		<Row Name="ICON_BELIEF_CUSTOM_FIRST_SETTLERS" Atlas="ICON_ATLAS_EUROPA_BELIEFS_PATHEON" Index="0"/>
		<Row Name="ICON_BELIEF_CUSTOM_SACRED_COMPANIONS" Atlas="ICON_ATLAS_EUROPA_BELIEFS_PATHEON" Index="1"/>
