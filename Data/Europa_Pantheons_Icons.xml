		<Row Name="ICON_BELIEF_CUSTOM_ARTISTIC_INSPIRATION" Atlas="ICON_ATLAS_EUROPA_BELIEFS_PATHEON" Index="4"/>
		<Row Name="ICON_BELIEF_CUSTOM_PILLARS_OF_CREATION" Atlas="ICON_ATLAS_EUROPA_BELIEFS_PATHEON" Index="5"/>
	</IconDefinitions>
</GameInfo>
