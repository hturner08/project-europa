<?xml version="1.0" encoding="utf-8"?>
<Mod id="7fe8ff0a-8385-4631-b121-6032c7cce1f5" version="1">
	<Properties>
		<Name>Project Europa</Name>
		<Description>Seven luxury resources (Topaz, Peacocks, Pallas's Cats, Pygmy Rabbits, Tibetan Foxes, Discus Fish, Capybaras), the Fish Weir, bigger deserts, six city-states (Syracuse, Ubud, Sheffield, Ravenna, Lhasa, Bruges) and eight custom leaders balanced against Better Balanced Game: Golden Expansion (Mali), Imperial Gardens (China), Highland Empire (Ethiopia), Living Paradise (Brazil), Borderless Empire (Cree), Endless Continent (Russia), Scenic Genius (America) and Palace Designer (France).</Description>
		<Teaser>New luxuries, bigger deserts, six city-states, eight custom leaders.</Teaser>
		<Authors>Project Europa</Authors>
		<AffectsSavedGames>1</AffectsSavedGames>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
	</Properties>
	<ActionCriteria>
		<Criteria id="Expansion2">
			<GameCoreInUse>Expansion2</GameCoreInUse>
		</Criteria>
	</ActionCriteria>
	<InGameActions>
		<!-- LoadOrder > 0 so the expansions' Features/Tags rows exist before our INSERT ... SELECTs run. -->
		<UpdateDatabase id="EuropaGameplay">
			<Properties>
				<LoadOrder>100</LoadOrder>
			</Properties>
			<File>Data/Europa_Resources.sql</File>
		</UpdateDatabase>
		<!-- Custom leaders. Gathering Storm only. The LoadOrder is above Better Balanced Game's
		     (its last gameplay action is 100000000) because Europa_Leader_Mali.sql reads rows BBG
		     adds. Europa_LeaderCommon.sql must stay first; each leader is its own file so a
		     missing DLC civilization only drops that leader. -->
		<UpdateDatabase id="EuropaLeaders" criteria="Expansion2">
			<Properties>
				<LoadOrder>100000100</LoadOrder>
			</Properties>
			<File>Data/Europa_LeaderCommon.sql</File>
			<File>Data/Europa_Leader_Mali.sql</File>
			<File>Data/Europa_Leader_China.sql</File>
			<File>Data/Europa_Leader_Ethiopia.sql</File>
			<File>Data/Europa_Leader_Brazil.sql</File>
			<File>Data/Europa_Leader_Cree.sql</File>
			<File>Data/Europa_Leader_Russia.sql</File>
			<File>Data/Europa_Leader_America.sql</File>
			<File>Data/Europa_Leader_France.sql</File>
		</UpdateDatabase>
		<!-- City-states. Gathering Storm only. Europa_CityStateCommon.sql must stay first; each
		     city-state is its own file so one bad row only drops that city-state. -->
		<UpdateDatabase id="EuropaCityStates" criteria="Expansion2">
			<Properties>
				<LoadOrder>100000100</LoadOrder>
			</Properties>
			<File>Data/Europa_CityStateCommon.sql</File>
			<File>Data/Europa_CityState_Syracuse.sql</File>
			<File>Data/Europa_CityState_Ubud.sql</File>
			<File>Data/Europa_CityState_Sheffield.sql</File>
			<File>Data/Europa_CityState_Ravenna.sql</File>
			<File>Data/Europa_CityState_Lhasa.sql</File>
			<File>Data/Europa_CityState_Bruges.sql</File>
		</UpdateDatabase>
		<!-- Copies the per-city-state rows Better Balanced Game makes for the stock city-states,
		     so it must run after BBG (last gameplay action 100000000) and after the files above. -->
		<UpdateDatabase id="EuropaCityStatesBBG" criteria="Expansion2">
			<Properties>
				<LoadOrder>100000200</LoadOrder>
			</Properties>
			<File>Data/Europa_CityStates_BBG.sql</File>
		</UpdateDatabase>
		<UpdateColors id="EuropaCityStateColors" criteria="Expansion2">
			<File>Data/Europa_CityStates_Colors.xml</File>
		</UpdateColors>
		<UpdateIcons id="EuropaCityStateIcons" criteria="Expansion2">
			<File>Data/Europa_CityStates_Icons.xml</File>
		</UpdateIcons>
		<ImportFiles id="EuropaCityStateTextures" criteria="Expansion2">
			<File>Textures/Europa_CityStates22.dds</File>
			<File>Textures/Europa_CityStates30.dds</File>
			<File>Textures/Europa_CityStates32.dds</File>
			<File>Textures/Europa_CityStates36.dds</File>
			<File>Textures/Europa_CityStates44.dds</File>
			<File>Textures/Europa_CityStates45.dds</File>
			<File>Textures/Europa_CityStates48.dds</File>
			<File>Textures/Europa_CityStates50.dds</File>
			<File>Textures/Europa_CityStates64.dds</File>
			<File>Textures/Europa_CityStates80.dds</File>
			<File>Textures/Europa_CityStates128.dds</File>
			<File>Textures/Europa_CityStates200.dds</File>
			<File>Textures/Europa_CityStates256.dds</File>
		</ImportFiles>
		<AddGameplayScripts id="EuropaCityStateScripts" criteria="Expansion2">
			<File>Scripts/Europa_CityStates.lua</File>
		</AddGameplayScripts>
		<UpdateColors id="EuropaLeaderColors" criteria="Expansion2">
			<File>Data/Europa_Leaders_Colors.xml</File>
		</UpdateColors>
		<UpdateIcons id="EuropaIcons">
			<File>Data/Europa_Icons.xml</File>
		</UpdateIcons>
		<!-- Leader icons point at atlases the expansions and DLC define, and the icon database
		     enforces that with a foreign key, so this must load after theirs. Without the
		     LoadOrder the game log showed "FOREIGN KEY constraint failed" on the first row. -->
		<UpdateIcons id="EuropaLeaderIcons" criteria="Expansion2">
			<Properties>
				<LoadOrder>100000100</LoadOrder>
			</Properties>
			<File>Data/Europa_Leaders_Icons.xml</File>
		</UpdateIcons>
		<UpdateText id="EuropaText">
			<File>Text/Europa_Text_en_US.xml</File>
			<File>Text/Europa_Leaders_Text_en_US.xml</File>
			<File>Text/Europa_CityStates_Text_en_US.xml</File>
		</UpdateText>
		<ImportFiles id="EuropaTextures">
			<File>Textures/Europa_Resources32.dds</File>
			<File>Textures/Europa_Resources38.dds</File>
			<File>Textures/Europa_Resources50.dds</File>
			<File>Textures/Europa_Resources64.dds</File>
			<File>Textures/Europa_Resources256.dds</File>
			<File>Textures/Europa_Resources256_FOW.dds</File>
			<File>Textures/Europa_FontIcons22.dds</File>
		</ImportFiles>
		<!-- Bigger deserts. Replaces the Gathering Storm TerrainGenerator.lua (stock file + appended
		     hook, see tools/make_terrain_override.py), so it needs a higher LoadOrder than the
		     expansion's own import and only applies under the Gathering Storm ruleset. -->
		<ImportFiles id="EuropaMaps" criteria="Expansion2">
			<Properties>
				<LoadOrder>2000</LoadOrder>
			</Properties>
			<File>Maps/Utility/TerrainGenerator.lua</File>
			<File>Maps/Europa_DesertGrowth.lua</File>
		</ImportFiles>
		<UpdateArt id="EuropaArt">
			<File>ProjectEuropa.dep</File>
		</UpdateArt>
		<AddGameplayScripts id="EuropaScripts">
			<File>Scripts/Europa_LakeResources.lua</File>
		</AddGameplayScripts>
		<AddGameplayScripts id="EuropaLeaderScripts" criteria="Expansion2">
			<File>Scripts/Europa_Leaders.lua</File>
		</AddGameplayScripts>
	</InGameActions>
	<!-- Game-setup screens: this is what makes the leaders selectable. The config rows copy
	     from the stock leaders' rows, so they load late, after every DLC has added its own. -->
	<FrontEndActions>
		<UpdateDatabase id="EuropaLeadersConfig">
			<Properties>
				<LoadOrder>100000100</LoadOrder>
			</Properties>
			<File>Config/Europa_Leaders_Config.sql</File>
		</UpdateDatabase>
		<!-- City-state picker rows, with the names, icons and icon textures the picker shows. -->
		<UpdateDatabase id="EuropaCityStatesConfig">
			<File>Config/Europa_CityStates_Config.sql</File>
		</UpdateDatabase>
		<UpdateColors id="EuropaCityStateColorsFrontEnd">
			<File>Data/Europa_CityStates_Colors.xml</File>
		</UpdateColors>
		<UpdateIcons id="EuropaCityStateIconsFrontEnd">
			<File>Data/Europa_CityStates_Icons.xml</File>
		</UpdateIcons>
		<ImportFiles id="EuropaCityStateTexturesFrontEnd">
			<File>Textures/Europa_CityStates22.dds</File>
			<File>Textures/Europa_CityStates30.dds</File>
			<File>Textures/Europa_CityStates32.dds</File>
			<File>Textures/Europa_CityStates36.dds</File>
			<File>Textures/Europa_CityStates44.dds</File>
			<File>Textures/Europa_CityStates45.dds</File>
			<File>Textures/Europa_CityStates48.dds</File>
			<File>Textures/Europa_CityStates50.dds</File>
			<File>Textures/Europa_CityStates64.dds</File>
			<File>Textures/Europa_CityStates80.dds</File>
			<File>Textures/Europa_CityStates128.dds</File>
			<File>Textures/Europa_CityStates200.dds</File>
			<File>Textures/Europa_CityStates256.dds</File>
		</ImportFiles>
		<UpdateColors id="EuropaLeaderColorsFrontEnd">
			<File>Data/Europa_Leaders_Colors.xml</File>
		</UpdateColors>
		<UpdateIcons id="EuropaLeaderIconsFrontEnd">
			<Properties>
				<LoadOrder>100000100</LoadOrder>
			</Properties>
			<File>Data/Europa_Leaders_Icons.xml</File>
		</UpdateIcons>
		<UpdateText id="EuropaLeaderTextFrontEnd">
			<File>Text/Europa_Leaders_Text_en_US.xml</File>
			<File>Text/Europa_CityStates_Text_en_US.xml</File>
		</UpdateText>
		<UpdateArt id="EuropaArtFrontEnd">
			<File>ProjectEuropa.dep</File>
		</UpdateArt>
	</FrontEndActions>
	<Files>
		<File>ProjectEuropa.dep</File>
		<File>Config/Europa_CityStates_Config.sql</File>
		<File>Data/Europa_CityStateCommon.sql</File>
		<File>Data/Europa_CityState_Syracuse.sql</File>
		<File>Data/Europa_CityState_Ubud.sql</File>
		<File>Data/Europa_CityState_Sheffield.sql</File>
		<File>Data/Europa_CityState_Ravenna.sql</File>
		<File>Data/Europa_CityState_Lhasa.sql</File>
		<File>Data/Europa_CityState_Bruges.sql</File>
		<File>Data/Europa_CityStates_BBG.sql</File>
		<File>Data/Europa_CityStates_Colors.xml</File>
		<File>Data/Europa_CityStates_Icons.xml</File>
		<File>Text/Europa_CityStates_Text_en_US.xml</File>
		<File>Scripts/Europa_CityStates.lua</File>
		<File>Textures/Europa_CityStates22.dds</File>
		<File>Textures/Europa_CityStates30.dds</File>
		<File>Textures/Europa_CityStates32.dds</File>
		<File>Textures/Europa_CityStates36.dds</File>
		<File>Textures/Europa_CityStates44.dds</File>
		<File>Textures/Europa_CityStates45.dds</File>
		<File>Textures/Europa_CityStates48.dds</File>
		<File>Textures/Europa_CityStates50.dds</File>
		<File>Textures/Europa_CityStates64.dds</File>
		<File>Textures/Europa_CityStates80.dds</File>
		<File>Textures/Europa_CityStates128.dds</File>
		<File>Textures/Europa_CityStates200.dds</File>
		<File>Textures/Europa_CityStates256.dds</File>
		<File>ArtDefs/Resources.artdef</File>
		<File>ArtDefs/Improvements.artdef</File>
		<File>ArtDefs/Leaders.artdef</File>
		<File>ArtDefs/FallbackLeaders.artdef</File>
		<File>Config/Europa_Leaders_Config.sql</File>
		<File>Data/Europa_LeaderCommon.sql</File>
		<File>Data/Europa_Leader_Mali.sql</File>
		<File>Data/Europa_Leader_China.sql</File>
		<File>Data/Europa_Leader_Ethiopia.sql</File>
		<File>Data/Europa_Leader_Brazil.sql</File>
		<File>Data/Europa_Leader_Cree.sql</File>
		<File>Data/Europa_Leader_Russia.sql</File>
		<File>Data/Europa_Leader_America.sql</File>
		<File>Data/Europa_Leader_France.sql</File>
		<File>Data/Europa_Leaders_Colors.xml</File>
		<File>Data/Europa_Leaders_Icons.xml</File>
		<File>Text/Europa_Leaders_Text_en_US.xml</File>
		<File>Scripts/Europa_Leaders.lua</File>
		<File>Data/Europa_Resources.sql</File>
		<File>Data/Europa_Icons.xml</File>
		<File>Text/Europa_Text_en_US.xml</File>
		<File>Scripts/Europa_LakeResources.lua</File>
		<File>Maps/Utility/TerrainGenerator.lua</File>
		<File>Maps/Europa_DesertGrowth.lua</File>
		<File>Textures/Europa_Resources32.dds</File>
		<File>Textures/Europa_Resources38.dds</File>
		<File>Textures/Europa_Resources50.dds</File>
		<File>Textures/Europa_Resources64.dds</File>
		<File>Textures/Europa_Resources256.dds</File>
		<File>Textures/Europa_Resources256_FOW.dds</File>
		<File>Textures/Europa_FontIcons22.dds</File>
	</Files>
</Mod>
